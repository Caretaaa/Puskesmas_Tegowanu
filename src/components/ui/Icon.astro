const isFill = name in fill;
const paths = isFill ? [fill[name]] : stroke[name] ?? [];
const classNames = className.trim().split(/\s+/).filter(Boolean);
const sizeClass = classNames.find((c) => /^(w|h)-/.test(c));
const style = sizeClass ? {} : { width: `${size}px`, height: `${size}px` };
---

{
  isFill ? (
    <svg viewBox="0 0 24 24" class={className} style={style} aria-hidden="true" focusable="false">
      <path fill="currentColor" d={paths[0]} />
    </svg>
  ) : (
    <svg
      viewBox="0 0 24 24"
      class={className}
      style={style}
      fill="none"
      stroke="currentColor"
      stroke-width={strokeWidth}
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      {paths.map((d) => <path d={d}></path>)}
    </svg>
  )
}