---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import { articleJsonLd } from '@/lib/seo';
import { SITE } from '@/lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('berita');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const fmtDate = (d: Date) =>
  new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);

const words = post.body.trim().split(/\s+/).length;
const readingMinutes = Math.max(1, Math.round(words / 200));

const url = new URL(`/berita/${post.slug}`, SITE.url).href;
const shareText = encodeURIComponent(`${post.data.title} — ${SITE.shortName}`);
const shareLinks = [
  { href: `https://wa.me/?text=${shareText}%20${encodeURIComponent(url)}`, label: 'WhatsApp' },
  { href: `https://t.me/share/url?url=${encodeURIComponent(url)}&text=${shareText}`, label: 'Telegram' },
  { href: `https://twitter.com/intent/tweet?text=${shareText}&url=${encodeURIComponent(url)}`, label: 'X (Twitter)' },
];
---

<Layout
  title={post.data.title}
  path={`/berita/${post.slug}`}
  article
  navActive="berita"
  jsonLd={articleJsonLd({
    title: post.data.title,
    excerpt: post.data.excerpt,
    image: post.data.image,
    datePublished: post.data.date.toISOString(),
    url,
  })}
>
  <article class="section-pad">
    <div class="wrap max-w-3xl">
      <a
        href="/#berita"
        class="inline-flex items-center gap-2 text-sm font-semibold text-teal-700 transition-colors hover:text-teal-900"
      >
        <span data-i18n="news.back">← Kembali ke Berita</span>
      </a>

      <p class="mt-8 font-mono text-sm font-bold uppercase tracking-wider text-amber-600">{fmtDate(post.data.date)}</p>

      <h1 class="mt-3 font-display text-section font-bold leading-tight text-balance text-teal-950">
        {post.data.title}
      </h1>

      <p class="mt-3 font-mono text-xs text-ink-soft">
        {readingMinutes} <span data-i18n="news.minutes">menit baca</span>
      </p>

      <div class="mt-8 overflow-hidden rounded-3xl border border-line shadow-card">
        <img
          src={post.data.image}
          alt=""
          width="900"
          height="520"
          decoding="async"
          class="aspect-[16/9] w-full object-cover"
        />
      </div>

      <div class="prose-pusk mt-10">
        <Content />
      </div>

      <div class="mt-12 border-t border-line pt-8">
        <p class="mb-3 text-sm font-semibold text-teal-900" data-i18n="news.share">Bagikan artikel ini</p>
        <div class="flex flex-wrap gap-2">
          {shareLinks.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-full border border-line bg-white px-4 py-2 text-sm font-medium text-ink-soft transition-colors hover:border-teal-700 hover:text-teal-900"
            >
              {s.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </article>
</Layout>