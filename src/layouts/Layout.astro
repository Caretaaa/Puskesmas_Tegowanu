---
import '@/styles/global.css';
import BaseHead from '@/components/BaseHead.astro';
import Topbar from '@/components/Topbar.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Globals from '@/components/Globals';
import { organizationJsonLd } from '@/lib/seo';

interface Props {
  title: string;
  description?: string;
  path?: string;
  article?: boolean;
  noindex?: boolean;
  /** Which top-level nav item should render as active. */
  navActive?: 'home' | 'profil' | 'layanan' | 'survey' | 'berita' | 'galeri' | 'kontak';
  jsonLd?: string;
  pageClass?: string;
}

const {
  title,
  description,
  path = '/',
  article,
  noindex,
  navActive,
  jsonLd,
  pageClass = '',
} = Astro.props;
---

<!doctype html>
<html lang="id" data-lang="id">
  <head>
    <BaseHead title={title} description={description} path={path} article={article} noindex={noindex} jsonLd={jsonLd} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only z-[100] rounded-full bg-teal-900 px-4 py-2 text-white focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
    >
      <span data-i18n="a11y.skip">Lompat ke konten utama</span>
    </a>

    <header class="no-print">
      <Topbar />
      <Header navActive={navActive} />
    </header>

    <main id="main" class={pageClass}>
      <slot />
    </main>

    <Footer />

    <Globals client:idle />
    <script src="../scripts/i18n.ts"></script>
    <script is:inline set:html={organizationJsonLd()} type="application/ld+json"></script>
  </body>
</html>